; Kopieren nach secrets.ini und anpassen. secrets.ini steht in .gitignore.
; Nur die Werte eintragen, die vom Default in platformio.ini abweichen sollen.
; Hinweis: keine " oder ' in den Werten verwenden.
[secrets]
wifi_ssid    = MeinWLAN
wifi_pass    = geheim
ota_password = anderes-geheimnis
ota_ip       = 192.168.1.50
ap_password  = mind8zeichen
